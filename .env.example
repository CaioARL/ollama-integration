# Arquivo de exemplo para configuração de variáveis de ambiente

# Configurações do Servidor
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/ollama-integration

# Configurações do Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de embeddings para busca semântica
# Opções: all-minilm (rápido), nomic-embed-text (melhor), mxbai-embed-large (alta qualidade)
OLLAMA_EMBEDDING_MODEL=all-minilm

# Configurações de Similaridade Semântica (RAG)
# Valores entre 0.0 (menos restritivo) e 1.0 (mais restritivo)
# RAG Threshold: usado para buscar contexto relevante em conversações
# Valor alto (0.70-0.80) = mais preciso, menos documentos, evita "ruído"
SIMILARITY_RAG_THRESHOLD=0.70
# Conversation Threshold: usado para buscar conversações similares
# Pode ser menos restritivo que RAG para encontrar mais resultados
SIMILARITY_CONVERSATION_THRESHOLD=0.60
# Default Threshold: usado para outras buscas gerais
SIMILARITY_DEFAULT_THRESHOLD=0.60

# Configurações JWT
# Gere uma chave secreta forte para produção
JWT_SECRET=sua-chave-secreta-aqui-mude-em-producao
JWT_EXPIRATION=3600000

# Configuração MongoDB
MONGODB_URI=mongodb://admin:admin123@localhost:27017/ollama_chat?authSource=admin
MONGODB_DATABASE=ollama_chat

# Configurações Kafka
KAFKA_CONSUMER_GROUP_ID=embedding-service-group
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCER_ACKS=1
KAFKA_PRODUCER_RETRIES=5