# Arquivo de exemplo para configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# Configurações do Servidor
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/ollama-integration

# Configurações do Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.7

# Configurações JWT
# Gere uma chave secreta forte para produção
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=3600000

# Credenciais de Autenticação
# IMPORTANTE: Altere estes valores para produção!
AUTH_SUBJECT=myapp
AUTH_ACCESS_KEY=your-access-key-here
